#!/usr/bin/env python3

import os
import subprocess
import sys
from pathlib import Path

btop_config = (
    Path(os.path.expanduser("~"))
    .joinpath(".config")
    .joinpath("btop")
    .joinpath("btop.conf")
)
btop_dark_theme = 'tokyo-night.theme'
btop_white_theme = 'whiteout.theme'
btop_current_themes_dir = (Path(os.path.expanduser("~"))
    .joinpath(".config")
    .joinpath("btop")
    .joinpath("themes")
)
btop_current_theme_path = btop_current_themes_dir.joinpath("current.theme")


def set_plasma_theme(dark_mode):
    if dark_mode:
        theme = 'org.kde.breezedark.desktop'
    else:
        theme = 'org.kde.breeze.desktop'
    subprocess.Popen(["/usr/bin/lookandfeeltool", "--apply", theme], preexec_fn=os.setsid)


def set_btop_theme(dark_mode):
    if dark_mode:
        theme = btop_dark_theme
    else:
        theme = btop_white_theme
    os.remove(btop_current_theme_path)
    os.symlink(btop_current_themes_dir.joinpath(theme), btop_current_theme_path)
    subprocess.Popen(["pkill", "-SIGUSR2", "btop"], preexec_fn=os.setsid)


def detect_dark_mode():
    if len(sys.argv) == 2:
        if sys.argv[1] == "on":
            return True
        else:
            return False
    try:
        if btop_current_theme_path.is_symlink():
            target_path = os.readlink(btop_current_theme_path)
            target_filename = Path(target_path).name
            return target_filename == btop_white_theme
    except OSError:
        return False


dark_mode = detect_dark_mode()
set_plasma_theme(dark_mode)
set_btop_theme(dark_mode)
