#!/usr/bin/env python3

import os
import re
import subprocess
import sys
import time
from pathlib import Path
from subprocess import PIPE


def set_plasma_theme(dark_mode):
    if dark_mode:
        theme = "org.kde.breezedark.desktop"
    else:
        theme = "org.kde.breeze.desktop"
    # subprocess.Popen(["/usr/bin/lookandfeeltool", "--apply", 'org.kde.oxygen'], preexec_fn=os.setsid)
    # time.sleep(0.5)
    subprocess.Popen(
        ["/usr/bin/lookandfeeltool", "--apply", theme], preexec_fn=os.setsid
    )


def set_btop_theme(dark_mode):
    if dark_mode:
        theme = "tokyo-night.theme"
    else:
        theme = "whiteout.theme"
    themes_dir = Path(os.path.expanduser("~/.config/btop/themes"))
    current_theme_path = Path(themes_dir).joinpath("current.theme")
    if current_theme_path.exists():
        os.remove(current_theme_path)
    os.symlink(themes_dir.joinpath(theme), current_theme_path)
    subprocess.Popen(["pkill", "-SIGUSR2", "btop"], preexec_fn=os.setsid)


def set_pi_theme(dark_mode):
    import json

    settings_path = Path(os.path.expanduser("~/.pi/agent/settings.json"))
    settings_path.parent.mkdir(parents=True, exist_ok=True)

    # Read existing settings if present
    settings = {}
    try:
        if settings_path.exists():
            with open(settings_path, "r", encoding="utf-8") as f:
                try:
                    settings = json.load(f) or {}
                except json.JSONDecodeError:
                    # If the file is corrupted or empty, overwrite with a fresh dict
                    settings = {}
    except Exception:
        # If we cannot read the file for some reason, proceed with defaults
        settings = {}
    settings["theme"] = "dark" if dark_mode else "light"

    # Write atomically to avoid leaving a partial file
    tmp_path = settings_path.with_suffix(".tmp")
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=2)
    os.replace(tmp_path, settings_path)


def set_alacritty_theme(dark_mode):
    if dark_mode:
        theme_filename = "modus-vivendi.toml"
    else:
        theme_filename = "modus-operandi.toml"
    config_dir = Path(os.path.expanduser("~/.config/alacritty"))

    # Prefer alacritty.toml, but fall back to alacritty.yml if that's what the user has.
    config_path = config_dir.joinpath("alacritty.toml")
    content = config_path.read_text(encoding="utf-8")
    pattern = re.compile(r"modus-(?:operandi|vivendi)(?:\.toml)?")
    new_content, num_subs = pattern.subn(theme_filename, content)
    tmp_path = config_path.with_suffix(config_path.suffix + ".tmp")
    with open(tmp_path, "w", encoding="utf-8") as f:
        f.write(new_content)
    os.replace(tmp_path, config_path)


def set_konsole_theme(dark_mode):
    import configparser

    if dark_mode:
        color_scheme = "Modus Vivendi (WezTerm)"
    else:
        color_scheme = "Modus Operandi (WezTerm)"

    profile_path = Path(os.path.expanduser("~/.local/share/konsole/Default.profile"))

    # configparser preserves existing keys; we need case-sensitive keys for Konsole
    config = configparser.RawConfigParser()
    config.optionxform = str  # keep original key casing
    config.read(profile_path)
    config.set("Appearance", "ColorScheme", color_scheme)
    tmp_path = profile_path.with_suffix(".profile.tmp")
    with open(tmp_path, "w", encoding="utf-8") as f:
        config.write(f, space_around_delimiters=False)
    os.replace(tmp_path, profile_path)


def set_fish_theme(_dark_mode):
    subprocess.run(["pkill", "-USR1", "fish"], preexec_fn=os.setsid)


def detect_dark_mode():
    if len(sys.argv) == 2:
        if sys.argv[1] == "on":
            return True
        else:
            return False
    result = subprocess.run(
        [
            "qdbus",
            "org.freedesktop.portal.Desktop",
            "/org/freedesktop/portal/desktop",
            "org.freedesktop.portal.Settings.Read",
            "org.freedesktop.appearance",
            "color-scheme",
        ],
        check=False,
        stdout=PIPE,
        stderr=PIPE,
    )
    return result.stdout != b"1\n"


dark_mode = detect_dark_mode()
set_plasma_theme(dark_mode)
set_btop_theme(dark_mode)
set_pi_theme(dark_mode)
set_alacritty_theme(dark_mode)
set_konsole_theme(dark_mode)
set_fish_theme(dark_mode)
