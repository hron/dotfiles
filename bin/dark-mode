#!/usr/bin/env python3

import os
import subprocess
import sys
from pathlib import Path

btop_config = (
    Path(os.path.expanduser("~"))
    .joinpath(".config")
    .joinpath("btop")
    .joinpath("btop.conf")
)
btop_white_theme = 'whiteout'


def set_plasma_theme(dark_mode):
    if dark_mode:
        theme = 'org.kde.breezedark.desktop'
    else:
        theme = 'org.kde.breeze.desktop'
    subprocess.Popen(["/usr/bin/lookandfeeltool", "--apply", theme], preexec_fn=os.setsid)


def set_btop_theme(dark_mode):
    if dark_mode:
        theme = 'Default'
    else:
        theme = btop_white_theme
    with btop_config.open() as file:
        lines = [
            line if "color_theme" not in line else f'color_theme = "{theme}"\n'
            for line in file
        ]
    with btop_config.open("w") as file:
        for line in lines:
            file.write(line)
    subprocess.Popen(["pkill", "-SIGUSR2", "btop"], preexec_fn=os.setsid)


def detect_dark_mode():
    if len(sys.argv) == 2:
        if sys.argv[1] == "on":
            return True
        else:
            return False
    with btop_config.open() as file:
        return file.read().find(btop_white_theme) > 0


dark_mode = detect_dark_mode()
set_plasma_theme(dark_mode)
set_btop_theme(dark_mode)
