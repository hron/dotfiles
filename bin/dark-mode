#!/usr/bin/env python3

import os
import subprocess
import sys
import time
from pathlib import Path
from subprocess import PIPE


def set_plasma_theme(dark_mode):
    if dark_mode:
        theme = "org.kde.breezedark.desktop"
    else:
        theme = "org.kde.breeze.desktop"
    # subprocess.Popen(["/usr/bin/lookandfeeltool", "--apply", 'org.kde.oxygen'], preexec_fn=os.setsid)
    # time.sleep(0.5)
    subprocess.Popen(
        ["/usr/bin/lookandfeeltool", "--apply", theme], preexec_fn=os.setsid
    )


def set_btop_theme(dark_mode):
    if dark_mode:
        theme = "tokyo-night.theme"
    else:
        theme = "whiteout.theme"
    themes_dir = Path(os.path.expanduser("~/.config/btop/themes"))
    current_theme_path = Path(themes_dir).joinpath("current.theme")
    if current_theme_path.exists():
        os.remove(current_theme_path)
    os.symlink(themes_dir.joinpath(theme), current_theme_path)
    subprocess.Popen(["pkill", "-SIGUSR2", "btop"], preexec_fn=os.setsid)


def set_pi_theme(dark_mode):
    import json

    settings_path = Path(os.path.expanduser("~/.pi/agent/settings.json"))
    settings_path.parent.mkdir(parents=True, exist_ok=True)

    # Read existing settings if present
    settings = {}
    try:
        if settings_path.exists():
            with open(settings_path, "r", encoding="utf-8") as f:
                try:
                    settings = json.load(f) or {}
                except json.JSONDecodeError:
                    # If the file is corrupted or empty, overwrite with a fresh dict
                    settings = {}
    except Exception:
        # If we cannot read the file for some reason, proceed with defaults
        settings = {}
    settings["theme"] = "dark" if dark_mode else "light"

    # Write atomically to avoid leaving a partial file
    tmp_path = settings_path.with_suffix(".tmp")
    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=2)
    os.replace(tmp_path, settings_path)


def detect_dark_mode():
    if len(sys.argv) == 2:
        if sys.argv[1] == "on":
            return True
        else:
            return False
    result = subprocess.run(
        [
            "qdbus",
            "org.freedesktop.portal.Desktop",
            "/org/freedesktop/portal/desktop",
            "org.freedesktop.portal.Settings.Read",
            "org.freedesktop.appearance",
            "color-scheme",
        ],
        check=False,
        stdout=PIPE,
        stderr=PIPE,
    )
    return result.stdout != b"1\n"


dark_mode = detect_dark_mode()
set_plasma_theme(dark_mode)
set_btop_theme(dark_mode)
set_pi_theme(dark_mode)
