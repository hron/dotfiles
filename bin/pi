#!/bin/sh
set -eu

PROJECT_DIR="${PWD}"

PI_ROOT="${HOME}/.pi"
PI_AGENT_DIR="${HOME}/.pi/agent"
PI_NPM_DIR="${PI_AGENT_DIR}/npm"   # Pi’s own npm path

mkdir -p "$PI_ROOT" "$PI_AGENT_DIR" "$PI_NPM_DIR"

exec bwrap \
  --die-with-parent \
  --new-session \
  --unshare-pid \
  --unshare-ipc \
  --unshare-uts \
  --dev /dev \
  --proc /proc \
  --tmpfs /tmp \
  --ro-bind /bin /bin \
  --ro-bind /lib /lib \
  --ro-bind /lib64 /lib64 \
  --ro-bind /usr /usr \
  --ro-bind /etc/ssl /etc/ssl \
  --ro-bind /etc/ca-certificates /etc/ca-certificates \
  --ro-bind /etc/resolv.conf /etc/resolv.conf \
  --ro-bind /etc/hosts /etc/hosts \
  --ro-bind /etc/nsswitch.conf /etc/nsswitch.conf \
  --ro-bind /usr/share/zoneinfo /usr/share/zoneinfo \
  --bind "${PROJECT_DIR}" "${PROJECT_DIR}" \
  --bind "${PI_ROOT}" "${HOME}/.pi" \
  --bind "${PI_NPM_DIR}" "${HOME}/.pi/agent/npm" \
  --dir "${HOME}" \
  --setenv HOME "${HOME}" \
  --setenv PI_CONFIG_DIR "${HOME}/.pi" \
  --setenv PI_CODING_AGENT_DIR "${HOME}/.pi/agent" \
  --setenv npm_config_cache "${HOME}/.pi/agent/npm" \
  --setenv USER "${USER:-user}" \
  --setenv LOGNAME "${LOGNAME:-${USER:-user}}" \
  --setenv TMPDIR /tmp \
  --chdir "${PROJECT_DIR}" \
  /usr/bin/env npx --package=@mariozechner/pi-coding-agent -- pi "$@"
