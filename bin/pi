#!/bin/sh
set -eu

PROJECT_DIR="${PWD}"

PI_DIR="${HOME}/.pi"
CACHE_DIR="${HOME}/.cache"
STATE_DIR="${HOME}/.local/state"
SHARE_DIR="${HOME}/.local/share"

mkdir -p "$PI_DIR" "$CACHE_DIR" "$STATE_DIR" "$SHARE_DIR"

exec bwrap \
  --die-with-parent \
  --new-session \
  --unshare-pid \
  --unshare-ipc \
  --unshare-uts \
  --dev /dev \
  --proc /proc \
  --tmpfs /tmp \
  --ro-bind /bin /bin \
  --ro-bind /lib /lib \
  --ro-bind /lib64 /lib64 \
  --ro-bind /usr /usr \
  --ro-bind /etc/ssl /etc/ssl \
  --ro-bind /etc/ca-certificates /etc/ca-certificates \
  --ro-bind /etc/resolv.conf /etc/resolv.conf \
  --ro-bind /etc/hosts /etc/hosts \
  --ro-bind /etc/nsswitch.conf /etc/nsswitch.conf \
  --ro-bind /usr/share/zoneinfo /usr/share/zoneinfo \
  --bind "$PROJECT_DIR" "$PROJECT_DIR" \
  --bind "$PI_DIR" "$HOME/.pi" \
  --bind "$CACHE_DIR" "$HOME/.cache" \
  --bind "$STATE_DIR" "$HOME/.local/state" \
  --bind "$SHARE_DIR" "$HOME/.local/share" \
  --dir "$HOME" \
  --setenv HOME "$HOME" \
  --setenv PI_CONFIG_DIR "$HOME/.pi" \
  --setenv XDG_CACHE_HOME "$HOME/.cache" \
  --setenv XDG_STATE_HOME "$HOME/.local/state" \
  --setenv XDG_DATA_HOME "$HOME/.local/share" \
  --setenv npm_config_cache "$HOME/.cache/npm" \
  --setenv USER "${USER:-user}" \
  --setenv LOGNAME "${LOGNAME:-${USER:-user}}" \
  --setenv TMPDIR /tmp \
  --chdir "$PROJECT_DIR" \
  /usr/bin/env npx --package=@mariozechner/pi-coding-agent -- pi "$@"
