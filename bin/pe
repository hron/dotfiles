#! /usr/bin/env ruby

require 'fileutils'

def print_usage
  puts "Usage: pe NAME"
  exit 1
end

def dev_dir(name)
  File.join ENV['HOME'], 'src', "#{name}-dev"
end

def app_dir(name)
  File.join(dev_dir(name), name)
end

def prepare_development_environment_directory(name)
  FileUtils.mkdir_p dev_dir(name)
  FileUtils.mkdir_p app_dir(name)
end

def create_destkop_file(name)
  File.open(File.join(ENV['HOME'], "Desktop", "#{name}.desktop"), 'w') do |file|
    file << <<EOF
[Desktop Entry]
Exec=zsh -i -c "cd #{app_dir(name)} && exec emacs -mm -T #{name}"
Description=Development environment for #{name}
Icon=emacs23
StartupNotify=true
Terminal=false
Type=Application
Version=1.0
EOF
  end
end

def main
  name = ARGV[0]
  print_usage unless name

  prepare_development_environment_directory(name)
  create_destkop_file(name)
end

main
