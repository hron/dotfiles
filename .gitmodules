        path = .emacs.d/site-lisp/rinari
        url = git://github.com/eschulte/rinari.git
[submodule ".emacs.d/site-lisp/nxhtml"]
        path = .emacs.d/site-lisp/nxhtml
        url = git://github.com/emacsmirror/nxhtml.git
