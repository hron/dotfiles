,536871416]],["^15",[234,"^Y","zed",536871416]],["^15",[234,"^11","zed",536871416]],["^15",[234,"^B",1731239829674,536871416]],["^15",[234,"^;","~u67e66e92-010c-4511-95c8-3253ec77f4ce",536874794]],["^15",[286,"^Q","",536871520]],["^15",[286,"^O","^16",536871520]],["^15",[286,"^@",false,536871520]],["^15",[286,"^F",184,536871520]],["^15",[286,"^X",184,536871520]],["^15",[286,"^V",184,536871520]],["^15",[286,"^U",184,536871521]],["^15",[286,"^;","~u6730a0ce-87e2-4ef7-9bde-1662be38a76b",536871520]],["^15",[287,"^3","* Full [[logseq]] plugin API: `src/main/logseq/api.cljs`",536872130]],["^15",[287,"^2:","~m1731321284982",536872131]],["^15",[287,"^Z","journals/2024_11_10.org",536871526]],["^15",[299,"^Q","",536871703]],["^15",[299,"^O","^16",536871703]],["^15",[299,"^@",false,536871703]],["^15",[299,"^F",94,536871703]],["^15",[299,"^X",94,536871703]],["^15",[299,"^V",94,536871703]],["^15",[299,"^U",94,536871704]],["^15",[299,"^?",["^ "],536871703]],["^15",[299,"^;","~u6730a282-d2eb-4624-98b5-0a8d57d6f14a",536871703]],["^15",[300,"^12",2,536871744]],["^15",[305,"^12",2,536871895]],["^15",[307,"^12",2,536871972]],["^15",[308,"^12",2,536871974]],["^15",[309,"^12",2,536871976]],["^15",[310,"^12",2,536871978]],["^15",[311,"^12",2,536871980]],["^15",[313,"^12",2,536872050]],["^15",[314,"^Q","Full [[logseq]] plugin API: `src/main/logseq/api.cljs`",536872130]],["^15",[314,"^O","^16",536872055]],["^15",[314,"^N",20241110,536872055]],["^15",[314,"^@",true,536872055]],["^15",[314,"^F",18,536872104]],["^15",[314,"^X",18,536872055]],["^15",[314,"^V",18,536872055]],["^15",[314,"^U",18,536872082]],["^15",[314,"^U",184,536872082]],["^15",[314,"^H",184,536872130]],["^15",[314,"^;","~u67310f0e-d364-4a48-ad74-6637c74f0b59",536872055]],["^15",[315,"^U",18,536872105]],["^15",[316,"^Q","Information about NVME configuration at [[thor]] \n\n\nДа, оба ваших накопителя лучше всего использовать с высокоскоростными слотами, но они работают на разных поколениях PCIe:\n1. **Samsung 980 Pro** — поддерживает **PCIe 4.0 x4**, поэтому для максимальной производительности его стоит установить в слот **M.2_1**, который поддерживает PCIe 4.0 с вашим процессором 11-го поколения.\n2. **Samsung 970 Evo** — использует **PCIe 3.0 x4**, и он может эффективно работать в одном из других слотов (M.2_2 или M.2_3), так как они поддерживают только PCIe 3.0.\nТаким образом, установите **980 Pro в M.2_1** для достижения максимальной скорости, а **970 Evo — в M.2_2 или M.2_3**.",536872175]],["^15",[316,"^O","^16",536872112]],["^15",[316,"^N",20241111,536872112]],["^15",[316,"^@",true,536872112]],["^15",[316,"^F",141,536872112]],["^15",[316,"^X",141,536872112]],["^15",[316,"^V",141,536872112]],["^15",[316,"^U",141,536872113]],["^15",[316,"^U",416,536872175]],["^15",[316,"^H",416,536872175]],["^15",[316,"^;","~u6731dd56-bfc2-4122-ab8f-5e4dae8188a1",536872112]],["^15",[317,"^3","* Information about NVME configuration at [[thor]] \n\n\nДа, оба ваших накопителя лучше всего использовать с высокоскоростными слотами, но они работают на разных поколениях PCIe:\n1. **Samsung 980 Pro** — поддерживает **PCIe 4.0 x4**, поэтому для максимальной производительности его стоит установить в слот **M.2_1**, который поддерживает PCIe 4.0 с вашим процессором 11-го поколения.\n2. **Samsung 970 Evo** — использует **PCIe 3.0 x4**, и он может эффективно работать в одном из других слотов (M.2_2 или M.2_3), так как они поддерживают только PCIe 3.0.\nТаким образом, установите **980 Pro в M.2_1** для достижения максимальной скорости, а **970 Evo — в M.2_2 или M.2_3**.",536872175]],["^15",[317,"^17",1731321190859,536872114]],["^15",[317,"^2:","~m1731349068172",536872176]],["^15",[317,"^Z","journals/2024_11_11.org",536872114]],["^15",[351,"^12",2,536872126]],["^15",[408,"^12",2,536872150]],["^15",[409,"^12",2,536872152]],["^15",[410,"^12",2,536872154]],["^15",[411,"^12",2,536872156]],["^15",[412,"^12",2,536872163]],["^15",[413,"^12",2,536872165]],["^15",[414,"^K",1731406035119,536872166]],["^15",[414,"^O","^16",536