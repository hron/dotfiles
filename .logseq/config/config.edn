 :editor/cycle-todo []
 :plugin.logseq13-missing-commands/mc-2-edit-block-5-prev-sibling ["alt+ctrl+up"]
 :editor/copy-embed []
 :go/forward ["alt+right"]
 :editor/toggle-checked ["ctrl+space"]
 :editor/zoom-in []
