#!/usr/bin/sh

URL="$1"

CURRENT_DESKTOP=$(kdotool get_desktop)
BROWSER_WINDOW=$(kdotool search --desktop "$CURRENT_DESKTOP" --class "firefox-nightly" | head -n1)

if [ -n "$BROWSER_WINDOW" ]; then
    kdotool windowactivate "$BROWSER_WINDOW"
    firefox-nightly --new-tab "$URL"
else
    firefox-nightly --new-window "$URL" &
fi
