#!/bin/sh
set -eu

HOME_DIR="${HOME}"
SRC_ROOT="${HOME_DIR}/src"
PROJECT_DIR="$(pwd -P)"

OPENCODE_CONFIG_HOME="${HOME_DIR}/.config/opencode"
OPENCODE_CACHE_HOME="${HOME_DIR}/.cache/opencode"
OPENCODE_STATE_HOME="${HOME_DIR}/.local/state/opencode"
OPENCODE_DATA_HOME="${HOME_DIR}/.local/share/opencode"
AGENTS_DIR="${HOME_DIR}/.agents"

case "$PROJECT_DIR" in
  "$SRC_ROOT"/*) ;;
  *)
    echo "opencode: refusing to start outside ${SRC_ROOT}" >&2
    exit 1
    ;;
esac

mkdir -p \
  "$OPENCODE_CONFIG_HOME" \
  "$OPENCODE_CACHE_HOME" \
  "$OPENCODE_STATE_HOME" \
  "$OPENCODE_DATA_HOME"

exec bwrap \
  --die-with-parent \
  --new-session \
  --unshare-pid \
  --unshare-ipc \
  --unshare-uts \
  --dev /dev \
  --proc /proc \
  --tmpfs /tmp \
  --ro-bind /bin /bin \
  --ro-bind /lib /lib \
  --ro-bind /lib64 /lib64 \
  --ro-bind /usr /usr \
  --ro-bind /etc/ssl /etc/ssl \
  --ro-bind /etc/ca-certificates /etc/ca-certificates \
  --ro-bind /etc/resolv.conf /etc/resolv.conf \
  --ro-bind /etc/hosts /etc/hosts \
  --ro-bind /etc/nsswitch.conf /etc/nsswitch.conf \
  --ro-bind /usr/share/zoneinfo /usr/share/zoneinfo \
  --ro-bind "$AGENTS_DIR" "$AGENTS_DIR" \
  --bind "$PROJECT_DIR" "$PROJECT_DIR" \
  --bind "$OPENCODE_CONFIG_HOME" "$HOME_DIR/.config/opencode" \
  --bind "$OPENCODE_CACHE_HOME" "$HOME_DIR/.cache/opencode" \
  --bind "$OPENCODE_STATE_HOME" "$HOME_DIR/.local/state/opencode" \
  --bind "$OPENCODE_DATA_HOME" "$HOME_DIR/.local/share/opencode" \
  --dir "$HOME_DIR" \
  --setenv HOME "$HOME_DIR" \
  --setenv XDG_CONFIG_HOME "$HOME_DIR/.config" \
  --setenv XDG_CACHE_HOME "$HOME_DIR/.cache" \
  --setenv XDG_STATE_HOME "$HOME_DIR/.local/state" \
  --setenv XDG_DATA_HOME "$HOME_DIR/.local/share" \
  --setenv OPENCODE_CONFIG_DIR "$HOME_DIR/.config/opencode" \
  --setenv USER "${USER:-user}" \
  --setenv LOGNAME "${LOGNAME:-${USER:-user}}" \
  --setenv TMPDIR /tmp \
  --chdir "$PROJECT_DIR" \
  /usr/bin/env opencode "$@"
