# Your keymap
#
# Atom keymaps work similarly to style sheets. Just as style sheets use
# selectors to apply styles to elements, Atom keymaps use selectors to associate
# keystrokes with events in specific contexts. Unlike style sheets however,
# each selector can only be declared once.
#
# You can create a new keybinding in this file by typing "key" and then hitting
# tab.
#
# Here's an example taken from Atom's built-in keymap:
#
# 'atom-text-editor':
#   'enter': 'editor:newline'
#
# 'atom-workspace':
#   'ctrl-shift-p': 'core:move-up'
#   'ctrl-p': 'core:move-down'
#
# You can find more information about keymaps in these guides:
# * https://atom.io/docs/latest/using-atom-basic-customization#customizing-key-bindings
# * https://atom.io/docs/latest/behind-atom-keymaps-in-depth
#
# If you're having trouble with your keybindings not working, try the
# Keybinding Resolver: `Cmd+.` on OS X and `Ctrl+.` on other platforms. See the
# Debugging Guide for more information:
# * https://atom.io/docs/latest/hacking-atom-debugging#check-the-keybindings
#
# This file uses CoffeeScript Object Notation (CSON).
# If you are unfamiliar with CSON, you can read more about it in the
# Atom Flight Manual:
# https://atom.io/docs/latest/using-atom-basic-customization#cson
'body':
  'ctrl-shift-S': 'window:save-all'
  'ctrl-x ctrl-f': 'advanced-open-file:toggle'
  'alt-down': 'window:focus-next-pane'
  'alt-up': 'window:focus-previous-pane'

'atom-workspace atom-text-editor:not([mini])':
  'alt-;': 'editor:toggle-line-comments'
  'ctrl-;': 'editor:toggle-line-comments'
  'alt-x': 'command-palette:toggle'
  'f6': 'editor:toggle-soft-wrap'
  'ctrl-alt-o': 'application:add-project-folder'
  'alt-.': 'symbols-view:go-to-declaration'
  'alt-,': 'symbols-view:return-from-declaration'
  'ctrl-alt-t': 'zentabs:toggletab'

'atom-workspace atom-text-editor':
  'alt-l': 'change-case:lower'
  'alt-u': 'change-case:upper'
  'alt-c': 'change-case:upperFirst'
  'ctrl-right': 'editor:move-to-next-subword-boundary'
  'ctrl-shift-right': 'editor:select-to-next-subword-boundary'
  'ctrl-left': 'editor:move-to-previous-subword-boundary'
  'ctrl-shift-left': 'editor:select-to-previous-subword-boundary'
  'ctrl-backspace': 'editor:delete-to-beginning-of-subword'
  'ctrl-delete': 'editor:delete-to-end-of-subword'
  'alt-q': 'autoflow:reflow-selection'

'atom-workspace atom-text-editor[data-grammar~="feature"]':
  'alt-.': 'cucumber-step:jump-to-step'

'.platform-win32 atom-workspace, .platform-linux atom-workspace':
  'shift-space': 'fuzzy-finder:toggle-file-finder'

'.platform-darwin, .platform-win32, .platform-linux':
  'alt-g alt-g': 'go-to-line:toggle'
  'alt-t': 'ruby-test-switcher:switch-without-split'
