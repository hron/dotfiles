"*":
  "advanced-open-file":
    createDirectories: true
    fuzzyMatch: true
    helmDirSwitch: true
  "atom-ctags":
    autoBuildTagsWhenActive: true
    disableComplete: true
  "comment-dwim-light": {}
  core:
    autoHideMenuBar: true
    disabledPackages: [
      "activate-power-mode"
      "tabs"
      "symbols-view"
    ]
    packagesWithKeymapsDisabled: [
      "auto-replace-in-selection"
      "ruby-block"
      "activate-power-mode"
      "highlight-line"
    ]
    projectHome: "E:\\src\\"
    themes: [
      "one-light-ui"
      "solarized-light-syntax"
    ]
  dash:
    filenames:
      "gruntfile.js": [
        "grunt"
      ]
    grammars:
      "Ruby Haml": [
        "ruby"
        "rails"
        "html"
        "javascript"
        "jquery"
        "css"
      ]
  editor:
    fontFamily: "Input Mono Medium"
    fontSize: 15
    invisibles: {}
    lineHeight: 1.2
    nonWordCharacters: "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-…_"
    preferredLineLength: 100
    scrollPastEnd: true
    showIndentGuide: true
    zoomFontWhenCtrlScrolling: false
  "exception-reporting":
    userId: "d583c4bd-71f3-9e8a-faa5-fc83973e361c"
  "fuzzy-finder": {}
  "highlight-line":
    hideHighlightOnSelect: true
  linter:
    showErrorPanel: false
    showErrorTabProject: false
  "linter-rubocop":
    command: "ruby.exe C:\\cygwin64\\home\\aleks\\.gem\\ruby\\gems\\rubocop-0.38.0\\bin\\rubocop"
  "linter-ruby": {}
  "linter-sass-lint": {}
  "linter-scspell": {}
  "merge-conflicts": {}
  "one-light-ui": {}
  "rails-rspec": {}
  "ruby-block-converter": {}
  "run-command2":
    shellCommand: "c:\\Cygwin64\\bin\\bash.exe"
  "spell-check": {}
  tabs:
    usePreviewTabs: true
  "toggle-quotes": {}
  welcome:
    showOnStartup: false
