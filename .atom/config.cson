"*":
  "advanced-open-file":
    createDirectories: true
    fuzzyMatch: true
    helmDirSwitch: true
  "comment-dwim-light": {}
  core:
    autoHideMenuBar: true
    disabledPackages: [
      "activate-power-mode"
    ]
    packagesWithKeymapsDisabled: [
      "auto-replace-in-selection"
      "ruby-block"
      "activate-power-mode"
    ]
    projectHome: "E:\\src\\"
    themes: [
      "one-light-ui"
      "one-light-syntax"
    ]
  editor:
    fontFamily: "Input Mono Medium "
    fontSize: 15
    invisibles: {}
    lineHeight: 1.2
    nonWordCharacters: "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-…_"
    preferredLineLength: 100
    scrollPastEnd: true
    showIndentGuide: true
  "exception-reporting":
    userId: "d583c4bd-71f3-9e8a-faa5-fc83973e361c"
  "fuzzy-finder": {}
  linter:
    showErrorPanel: false
    showErrorTabProject: false
  "linter-rubocop":
    command: "ruby.exe C:\\cygwin64\\home\\aleks\\.gem\\ruby\\gems\\rubocop-0.38.0\\bin\\rubocop"
  "linter-ruby": {}
  "linter-sass-lint": {}
  "linter-scspell": {}
  "merge-conflicts": {}
  "one-light-ui": {}
  "rails-rspec": {}
  "ruby-block-converter": {}
  "run-command2":
    shellCommand: "c:\\Cygwin64\\bin\\bash.exe"
  "spell-check": {}
  tabs:
    usePreviewTabs: true
  "toggle-quotes": {}
  welcome:
    showOnStartup: false
  'dash':
    'grammars':
      'Ruby Haml': [
        'ruby', 'html', 'javascript', 'jquery', 'css'
      ]
    'filenames':
      'gruntfile.js': [
        'grunt'
      ]
