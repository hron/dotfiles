[user]
    name = Aleksei Gusev
    email = aleksei.gusev@gmail.com

[core]
    excludesfile = ~/.gitconfig_global_gitignore
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    line-numbers = false

[diff]
    tool = zed

[difftool "zed"]
    cmd = zeditor --reuse --diff "$LOCAL" "$REMOTE"

[merge]
    tool = zed

[mergetool "zed"]
    cmd = zeditor  --reuse --wait "$MERGED"

[color]
    ui = true

[push]
	default = current

[github]
    user = hron

[init]
    defaultBranch = main

[rerere]
    enabled = true

[alias]
    zdiff = difftool --dir-diff --no-symlinks

[credential "https://github.com"]
    helper =
    helper = !/home/algus/.nix-profile/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/home/algus/.nix-profile/bin/gh auth git-credential
