[user]
	name = Aleksei Gusev
	email = aleksei.gusev@gmail.com
[core]
	excludesfile = ~/.gitconfig_global_gitignore
	pager =
	editor = emacs

[diff]
	tool = emacs

[difftool "emacs"]
	cmd = emacs --eval \"(ediff-files \\\"$LOCAL\\\" \\\"$REMOTE\\\")\"

[color]
	ui = true
[push]
	default = matching
[github]
	user = hron
[init]
	defaultBranch = main
