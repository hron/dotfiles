[user]
    name = Aleksei Gusev
    email = aleksei.gusev@gmail.com
[core]
    excludesfile = ~/.gitconfig_global_gitignore
    pager =

[diff]
    tool = zed
[difftool "emacs"]
    cmd = emacs --no-desktop --eval \"(ediff-files \\\"$LOCAL\\\" \\\"$REMOTE\\\")\"
[difftool "vscode"]
    cmd = "code --wait --diff  "
[difftool "zed"]
    cmd = zed --reuse --diff "$LOCAL" "$REMOTE"

[merge]
    tool = zed
[mergetool "zed"]
    cmd = zed  --reuse --wait "$MERGED"
[mergetool "emacs"]
    cmd = "emacs --no-desktop "
[mergetool "vscode"]
    cmd = "code --wait "


[color]
    ui = true
[push]
    default = matching
[github]
    user = hron
[init]
    defaultBranch = main
[rerere]
    enabled = true
[alias]
    zdiff = difftool --dir-diff --no-symlinks
[credential "https://github.com"]
    helper =
    helper = !/home/algus/.nix-profile/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/home/algus/.nix-profile/bin/gh auth git-credential
