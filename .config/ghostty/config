font-family = "JetBrains Mono Nerd Font"
font-size = "10"
theme = dark:modus-vivendi,light:modus-operandi
window-theme = auto
gtk-tabs-location = hidden
shell-integration-features = no-cursor
confirm-close-surface = false

keybind = clear
keybind = ctrl+t=new_tab
keybind = ctrl+shift+,=reload_config
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
keybind = alt+up=jump_to_prompt:-1
keybind = alt+down=jump_to_prompt:1
keybind = ctrl+shift+space=write_scrollback_file:open
keybind = ctrl+shift+alt+space=write_scrollback_file:paste
