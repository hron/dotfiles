// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  // "theme": {
  //   "dark": "Zedwaita Dark",
  //   "light": "Zedwaita Light"
  // },
  "file_scan_exclusions": [
    "**/.git/**/*",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings"
  ],
  "debugger": {
    "dock": "left"
  },
  "language_models": {
    "openai": {
      "version": "1",
      "available_models": []
    }
  },
  "theme": {
    "dark": "Modus Vivendi",
    "light": "Modus Operandi"
  },
  "resize_all_panels_in_dock": ["left", "right", "bottom"],
  "selection_highlight": true,
  "theme_overrides": {
    "Modus Operandi": {
      "search.match_background": "#bfefff",
      "editor.document_highlight.read_background": "#bfefff",
      "players": [
        {
          "background": "#e8dfd1ff",
          "selection": "#e8dfd1ff"
        }
      ]
    },
    "Modus Vivendi": {
      "search.match_background": "#004065",
      "editor.document_highlight.read_background": "#004065",
      "players": [
        {
          "background": "#462f20ff",
          "selection": "#462f20ff"
        }
      ]
    }
  },
  "scrollbar": {
    "axes": {
      "horizontal": false
    }
  },
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  // "buffer_font_family": "BlexMono Nerd Font",
  "buffer_font_size": 13,
  "buffer_font_weight": 500,
  // "buffer_line_height": "comfortable",
  "buffer_font_features": {
    "calt": false,
    "liga": false
  },
  "autosave": "on_focus_change",
  // Whether to use the system provided dialogs for Open and Save As.
  // When set to false, Zed will use the built-in keyboard-first pickers.
  "use_system_path_prompts": false,
  // When enabled, automatically adjusts search case sensitivity based on your query.
  // If your search query contains any uppercase letters, the search becomes case-sensitive;
  // if it contains only lowercase letters, the search becomes case-insensitive.
  "use_smartcase_search": true,
  "notification_panel": {
    "dock": "left"
  },
  "chat_panel": {
    "dock": "left"
  },
  "gutter": {
    "line_numbers": false
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "tabs": {
    "git_status": true,
    "close_position": "right",
    "file_icons": true,
    "show_close_button": "hidden",
    "show_diagnostics": "all"
  },
  // Toolbar related settings
  "toolbar": {
    // Whether to show breadcrumbs.
    "breadcrumbs": true,
    // Whether to show quick action buttons.
    "quick_actions": false,
    // Whether to show the Selections menu in the editor toolbar.
    "selections_menu": false,
    // Whether to show agent review buttons in the editor toolbar.
    "agent_review": false
  },
  "indent_guides": {
    "active_line_width": 2
    // "coloring": "indent_aware",
    // "background_coloring": "indent_aware"
  },
  "preview_tabs": {
    "enabled": false,
    "enable_preview_from_file_finder": true,
    "enable_preview_from_code_navigation": true
  },
  "terminal": {
    // "dock": "bottom",
    "dock": "left",
    "default_width": 900,
    // "font_family": "BlexMonoNF"
    // "font_size": 20,
    "font_weight": 500,
    // "line_height": "standard"
    // "shell": {
    //   "program": "bash"
    // }
    "toolbar": {
      "breadcrumbs": false
    }
  },
  "project_panel": {
    "dock": "left",
    "default_width": 400
  },
  "agent": {
    "dock": "left",
    "default_width": 900,
    "enabled": true
  },
  "git_panel": {
    "default_width": 400
  },
  "features": {
    // Which inline completion provider to use.
    "edit_prediction_provider": "zed"
  }
}
