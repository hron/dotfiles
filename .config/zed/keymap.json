  {
    "context": "Pane",
    "bindings": {
      "alt-1": null,
      "alt-2": null,
      "alt-3": null,
      "alt-4": null,
      "alt-5": null,
      "alt-6": null,
      "alt-7": null,
      "alt-8": null,
      "alt-9": null,
      "alt-0": null,
      "alt-left": "pane::GoBack",
      "alt-right": "pane::GoForward",
      "ctrl-shift-f": "project_search::ToggleFocus"
    }
  },

  {
    "context": "Workspace",
    "bindings": {
      "alt-x": "command_palette::Toggle",
      "alt-t": "task::Spawn",
      "alt-r": "task::Rerun",
      "ctrl-i": "workspace::CloseAllDocks",
      "ctrl-n": null,
      "alt-\\": "workspace::NewFile",
      "ctrl-p": null,
      "alt-1": "project_panel::ToggleFocus",
      "alt-2": null,
      "alt-3": null,
      "alt-4": null,
      "alt-5": null,
      "alt-6": null,
      "alt-7": null,
      "alt-8": null,
      "alt-9": null
    }
  }
