  {
    "context": "Pane",
    "bindings": {
      "alt-1": null,
      "alt-2": null,
      "alt-3": null,
      "alt-4": null,
      "alt-5": null,
      "alt-6": null,
      "alt-7": null,
      "alt-8": null,
      "alt-9": null,
      "alt-0": null,
      "ctrl-q": null,
      "alt-left": "pane::GoBack",
      "alt-right": "pane::GoForward",
      "ctrl-shift-f": "project_search::ToggleFocus"
      // "ctrl-alt-down": "search::SelectNextMatch",
      // "ctrl-alt-up": "search::SelectPrevMatch"
      // "ctrl-shift-g": "search::SelectNextMatch",
      // "ctrl-alt-shift-g": "search::SelectPrevMatch"
    }
  },
  {
    "context": "ProjectSearchView",
    "bindings": {
      "shift-ctrl-alt-f": "project_search::ToggleFilters"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-s": "workspace::SaveAll",
      "ctrl-alt-s": "workspace::Save",
      "alt-x": "command_palette::Toggle",
      "alt-t": "task::Spawn",
      "alt-r": "task::Rerun",
      "ctrl-i": "workspace::CloseAllDocks",
      "ctrl-p": null,
      "alt-1": "project_panel::ToggleFocus",
      "alt-2": null,
      "alt-3": null,
      "alt-4": null,
      "alt-5": null,
      "alt-6": null,
      "alt-7": null,
      "alt-8": null,
      "alt-9": null,
      "ctrl-q": null
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "escape": "terminal_panel::ToggleFocus",
      "ctrl-l": "terminal::Clear",
      "ctrl-t": "workspace::NewTerminal",
      "ctrl-v": "terminal::Paste",
      "ctrl-e": null,
      "ctrl-w": null,
      "ctrl-q": null
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "escape": "project_panel::ToggleFocus",
      "enter": "project_panel::OpenPermanent",
      "ctrl-q": null,
      "ctrl-shift-f": "project_panel::NewSearchInDirectory",
      "ctrl-shift-left": "project_panel::CollapseAllEntries",
      "f2": "project_panel::Rename",
      "f7": "project_panel::NewDirectory",
      "ctrl-shift-c": "project_panel::CopyPath",
      "ctrl-shift-alt-c": "project_panel::CopyRelativePath"
    }
  },
  {
    "context": "AssistantPanel",
    "bindings": {
      "escape": "assistant::ToggleFocus"
    }
  },
  {
    "context": "OutlinePanel",
    "bindings": {
      "shift-escape": "outline_panel::ToggleFocus"
    }
  }
]
