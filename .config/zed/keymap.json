[
  {
    "bindings": {
      "ctrl-\"": "workspace::ToggleZoom",
      // "ctrl-\"": "workspace::ActivateNextPane",
      // "ctrl-q": null
      "alt-up": "workspace::ActivatePreviousPane",
      "alt-down": "workspace::ActivateNextPane"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-k": null,
      // "alt-c": "editor::ConvertToLowerCase",
      // "alt-shift-c": "editor::ConvertToUpperCase",
      "shift-escape": "editor::Cancel",
      "ctrl-backspace": "editor::DeleteToPreviousSubwordStart",
      "ctrl-delete": "editor::DeleteToNextSubwordEnd",
      "ctrl-left": "editor::MoveToPreviousSubwordStart",
      "ctrl-right": "editor::MoveToNextSubwordEnd",
      "ctrl-up": "editor::MoveToStartOfParagraph",
      "ctrl-down": "editor::MoveToEndOfParagraph",
      "ctrl-shift-up": "editor::SelectToStartOfParagraph",
      "ctrl-shift-down": "editor::SelectToEndOfParagraph",
      "ctrl-h": "editor::SelectLargerSyntaxNode",
      "ctrl-shift-h": "editor::SelectSmallerSyntaxNode",
      "ctrl-d": "editor::DuplicateLineDown",
      "alt-shift-up": "editor::MoveLineUp",
      "alt-shift-down": "editor::MoveLineDown",
      "ctrl-shift-j": "editor::JoinLines",
      "ctrl-.": "editor::ToggleCodeActions",
      "ctrl-l": "editor::ScrollCursorCenter",
      "f1": "editor::ToggleSoftWrap",
      "ctrl-alt-z": "git::Restore",
      "alt-]": "editor::GoToHunk",
      "alt-[": "editor::GoToPreviousHunk",
      "ctrl-alt-[": "editor::ToggleSelectedDiffHunks",
      "f2": "editor::GoToDiagnostic",
      "shift-f2": "editor::GoToPreviousDiagnostic",
      "ctrl-alt-l": "editor::Format",
      "alt-.": "editor::GoToDefinition",
      "alt-ctrl-.": "editor::GoToTypeDefinition",
      // "alt-shift->": "editor::FindAllReferences",
      // "alt-shift-&": "editor::FindAllReferences",
      // "alt-shift-f7": "editor::FindAllReferences",
      "alt-m": "editor::MoveToEnclosingBracket",
      "alt->": "editor::FindAllReferences",
      "ctrl-q": "editor::Hover",
      "alt-q": "editor::Rewrap",
      "ctrl-alt-q": "editor::OpenDocs",
      "ctrl-t": "editor::Rename",
      "alt-j": [
        "editor::SelectNext",
        {
          "replace_newest": false
        }
      ],
      "alt-ctrl-shift-j": [
        "editor::SelectPrevious",
        {
          "replace_newest": false
        }
      ],
      "alt-ctrl-j": "editor::SelectAllMatches",
      "alt-shift-j": [
        "editor::SelectNext",
        {
          "replace_newest": true
        }
      ],
      "ctrl-k alt-ctrl-shift-j": [
        "editor::SelectPrevious",
        {
          "replace_newest": true
        }
      ],
      "ctrl-k alt-j": "editor::UndoSelection",
      "ctrl-shift-alt-f": null,
      "ctrl-alt-shift-f": null,
      "alt-shift-n": "workspace::ClearAllNotifications",
      "ctrl-alt-left": "editor::FoldAll",
      "ctrl-alt-right": "editor::UnfoldAll"
    }
  },
  {
    "context": "Editor && !edit_prediction",
    "bindings": {
      "alt-\\": null,
      "alt-/": "editor::ShowEditPrediction"
    }
  },
  {
    "context": "Editor && edit_prediction",
    "bindings": {
      "alt-/": null
    }
  },
  {
    "context": "Pane",
    "bindings": {
      // "alt-1": null,
      "alt-1": "project_panel::ToggleFocus",
      "alt-2": null,
      "alt-3": null,
      "alt-4": null,
      "alt-5": null,
      "alt-6": null,
      "alt-7": null,
      "alt-8": null,
      // "alt-9": null,
      "alt-0": null,
      "ctrl-q": null,
      "alt-left": "pane::GoBack",
      "alt-right": "pane::GoForward",
      "ctrl-r": "search::ToggleReplace",
      "alt-9": "git::Diff",
      "ctrl-alt-up": "search::SelectPreviousMatch",
      "ctrl-alt-down": "search::SelectNextMatch"
      // "ctrl-alft-f": "project_search::ToggleFilters"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-s": "workspace::SaveAll",
      "ctrl-alt-s": "workspace::Save",
      "alt-x": "command_palette::Toggle",
      "alt-t": "task::Spawn",
      "alt-r": "task::Rerun",
      "alt-i": "workspace::CloseAllDocks",
      "ctrl-p": null,
      "ctrl-e": ["file_finder::Toggle", { "separate_history": true }],
      "alt-1": "project_panel::ToggleFocus",
      "alt-2": null,
      "alt-3": null,
      "alt-4": null,
      "alt-5": null,
      "alt-6": null,
      "alt-7": null,
      "alt-8": null,
      // "alt-9": null,
      "ctrl-q": null,
      "alt-9": "git::Diff",
      "ctrl-k b": "git::Branch",
      "alt-shift-ctrl-o": "project_symbols::Toggle",
      "ctrl-k e": "editor::ToggleEditPrediction"
    }
  },
  {
    "context": "!ContextEditor > Editor && mode == full",
    "bindings": {
      "ctrl-shift-e": null,
      "ctrl-k e": "editor::ToggleEditPrediction"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-escape": "terminal_panel::ToggleFocus",
      "ctrl-t": "workspace::NewTerminal",
      "ctrl-v": "terminal::Paste",
      "ctrl-e": ["file_finder::Toggle", { "separate_history": true }],
      "ctrl-q": null,
      "ctrl-w": "pane::CloseActiveItem",
      "ctrl-delete": ["terminal::SendText", "\u001bd"],
      // "ctrl-f": "buffer_search::Deploy",
      // "ctrl-shift-f": "project_search::ToggleFocus",
      "ctrl-r": ["terminal::SendKeystroke", "ctrl-r"],
      "ctrl-z": ["terminal::SendKeystroke", "ctrl-z"],
      "ctrl-shift-z": ["terminal::SendKeystroke", "ctrl-shift-z"],
      "shift-pageup": ["terminal::SendKeystroke", "shift-pageup"],
      "shift-pagedown": ["terminal::SendKeystroke", "shift-pagedown"],
      "ctrl-alt-up": ["terminal::SendKeystroke", "ctrl-alt-up"],
      "ctrl-alt-down": ["terminal::SendKeystroke", "ctrl-alt-down"],
      "alt-up": ["terminal::SendKeystroke", "alt-up"],
      "alt-down": ["terminal::SendKeystroke", "alt-down"],
      "alt-space": ["terminal::SendKeystroke", "alt-space"]
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-escape": "project_panel::ToggleFocus",
      "enter": "project_panel::OpenPermanent",
      "ctrl-q": null,
      "ctrl-shift-f": "project_panel::NewSearchInDirectory",
      "ctrl-shift-left": "project_panel::CollapseAllEntries",
      "f2": "project_panel::Rename",
      "f7": "project_panel::NewDirectory",
      "ctrl-shift-c": "workspace::CopyPath",
      "ctrl-shift-alt-c": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "AssistantPanel",
    "bindings": {
      "ctrl-escape": "agent::ToggleFocus"
    }
  },
  {
    "context": "OutlinePanel",
    "bindings": {
      "shift-escape": "outline_panel::ToggleFocus"
    }
  }
]
