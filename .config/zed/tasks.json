  {
    "label": "wezterm",
    "command": "kstart wezterm start -- --cwd $ZED_WORKTREE_ROOT",
    "args": [],
    "reveal": "never",
    "hide": "always",
  },
  {
    "label": "opencode",
    "command": "kstart wezterm start -- --cwd $ZED_WORKTREE_ROOT -- opencode attach http://localhost:5173 --dir .",
    "args": [],
    "reveal": "never",
    "hide": "always",
  },
