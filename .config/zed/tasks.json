// Static tasks configuration.
//
// Example:
[
  {
    "label": "git commit",
    "command": "git",
    "args": ["commit"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "never",
  },
  {
    "label": "git commit --amend",
    "command": "git",
    "args": ["commit", "--amend"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "never",
  },
