// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  // "theme": {
  //   "dark": "Zedwaita Dark",
  //   "light": "Zedwaita Light"
  // },
  "theme": {
    "dark": "Modus Vivendi",
    "light": "Modus Operandi"
  },
  "vim_mode": false,
  "notification_panel": {
    "dock": "right"
  },
  "chat_panel": {
    "dock": "left"
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic"
      },
      "comment.doc": {
        "font_style": "italic"
      },
      "title": {
        "font_weight": 800
      }
    }
  },
  "ui_font_size": 18,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  // "buffer_font_family": "BlexMono Nerd Font",
  "buffer_font_size": 13,
  "buffer_font_weight": 700,
  // "buffer_line_height": "standard",
  "buffer_font_features": {
    "calt": false,
    "liga": false
  },
  "gutter": {
    "line_numbers": false
  },
  "tab_bar": {
    "show": false
  },
  "indent_guides": {
    "active_line_width": 2
    // "coloring": "indent_aware",
    // "background_coloring": "indent_aware"
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_preview_from_code_navigation": true
  },
  "terminal": {
    // "dock": "bottom",
    "dock": "bottom",
    "default_width": 650
    // "font_size": 20
    // "font_weight": 1000
  },
  "project_panel": {
    "dock": "left",
    "default_width": 650
  },
  "assistant": {
    "provider": {
      "name": "openai",
      "default_model": "gpt-4o",
      "default_width": 650,
      "available_models": []
    },
    "dock": "bottom",
    "default_width": 650,
    "version": "1",
    "enabled": true
  },
  "inlay_hints": {
    "enabled": true
  },
  "features": {
    // Which inline completion provider to use.
    "inline_completion_provider": "none"
  }
}
