// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "agent_ui_font_size": 17.0,
  "collaboration_panel": {
    "dock": "left",
  },
  "show_edit_predictions": false,
  "notification_panel": {
    "dock": "right",
    "default_width": 200,
  },
  "outline_panel": {
    "dock": "right",
    "default_width": 200,
  },
  "git_panel": {
    "dock": "right",
    "default_width": 200,
  },
  "project_panel": {
    "dock": "right",
    "default_width": 200,
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "\\bgrep\\b",
            },
            {
              "pattern": "\\bcat\\b",
            },
            {
              "pattern": "\\bgit\\b",
            },
            {
              "pattern": "\\bgh\\b",
            },
            {
              "pattern": "\\btrue\\b",
            },
            {
              "pattern": "\\bmkdir\\b",
            },
            {
              "pattern": "\\bhead\\b",
            },
            {
              "pattern": "\\btail\\b",
            },
            {
              "pattern": "\\bfind\\b",
            },
            {
              "pattern": "\\bxargs grep\\b",
            },
            {
              "pattern": "\\bls\\b",
            },
          ],
        },
        "search_web": {
          "default": "allow",
        },
        "fetch": {
          "default": "allow",
        },
        "save_file": {
          "default": "allow",
        },
        "create_directory": {
          "default": "allow",
        },
        "move_path": {
          "default": "allow",
        },
        "copy_path": {
          "default": "allow",
        },
        "edit_file": {
          "default": "allow",
        },
        "restore_file_from_disk": {
          "default": "allow",
        },
      },
    },
    "dock": "right",
    "default_width": 200,
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
      "enable_thinking": true,
      "effort": "medium",
    },
    "play_sound_when_agent_done": "always",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gpt-5-mini",
        "enable_thinking": false,
      },
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-4.6",
        "enable_thinking": true,
      },
    ],
    "model_parameters": [],
  },
  "buffer_line_height": "standard",
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
    "opencode": {
      "favorite_config_option_values": {
        "model": ["github-copilot/claude-sonnet-4.6", "github-copilot/gpt-5.1"],
      },
      "default_mode": "plan",
      "favorite_models": [
        "github-copilot/gpt-5-mini",
        "github-copilot/claude-sonnet-4.6",
      ],
      "type": "registry",
    },
    "github-copilot-cli": {
      "default_mode": "Plan",
      "default_model": "claude-sonnet-4.6",
      "favorite_config_option_values": {
        "mode": [
          "https://agentclientprotocol.com/protocol/session-modes#agent",
          "https://agentclientprotocol.com/protocol/session-modes#plan",
        ],
        "model": ["gpt-5-mini", "claude-sonnet-4.6"],
      },
      "type": "registry",
    },
  },
  "theme": {
    "dark": "Modus Vivendi",
    "light": "Modus Operandi",
  },
  "diff_view_style": "unified",
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot",
    // "mode": "subtle",
    "copilot": {
      "enable_next_edit_suggestions": false,
    },
  },
  // "edit_predictions": {
  //   "provider": "open_ai_compatible_api",
  //   "open_ai_compatible_api": {
  //     "api_url": "https://opencode.ai/zen/v1/chat/completions",
  //     "model": "gpt-5.4-mini",
  //     // "prompt_format": "deepseek_coder",
  //     // "prompt_format": "glm",
  //   },
  //   "mode": "eager",
  //   // "copilot": {
  //   //   "enable_next_edit_suggestions": false,
  //   // },
  // },
  "file_scan_exclusions": [
    "**/.git/**/*",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "language_models": {
    "openai": {
      "available_models": [],
    },
  },
  "resize_all_panels_in_dock": ["left", "right", "bottom"],
  "selection_highlight": true,
  "theme_overrides": {
    // "Modus Vivendi": {
    //   // "syntax": {
    //   //   "comment": {
    //   //     "color": "#ff0000",
    //   //     "font_style": "italic",
    //   //   },
    //   // },
    //   // "players": [
    //   //   {
    //   //     "selection": "#00ff00",
    //   //   },
    //   // ],
    // },
    // "Modus Vivendi Tinted": {
    //   "syntax": {
    //     "comment": {
    //       "color": "#989898",
    //       "font_style": "italic",
    //     },
    //   },
    // },
  },
  // "theme_overrides": {
  //   "Modus Operandi": {
  //     // "search.active_match_background": "#f3d000ff",
  //     // "editor.document_highlight.read_background": "#bfefff",
  //     "players": [
  //       {
  //         // "background": "#e8dfd1",
  //         "selection": "#bdae873d",
  //       },
  //     ],
  //   },
  //   "Modus Vivendi": {
  //     "players": [
  //       {
  //         // "background": "#e8dfd1",
  //         "selection": "#bdae873d",
  //       },
  //     ],
  //   },
  // },
  "scrollbar": {
    "axes": {
      "horizontal": false,
    },
  },
  "ui_font_size": 16.0,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  // "buffer_font_family": "BlexMono Nerd Font",
  "buffer_font_size": 13.0,
  // "buffer_font_weight": 400,
  // "buffer_line_height": "comfortable",
  "buffer_font_features": {
    "calt": false,
    "liga": false,
  },
  "autosave": "on_focus_change",
  // Whether to use the system provided dialogs for Open and Save As.
  // When set to false, Zed will use the built-in keyboard-first pickers.
  "use_system_path_prompts": false,
  // When enabled, automatically adjusts search case sensitivity based on your query.
  // If your search query contains any uppercase letters, the search becomes case-sensitive;
  // if it contains only lowercase letters, the search becomes case-insensitive.
  "use_smartcase_search": true,
  "gutter": {
    "line_numbers": false,
  },
  "tab_bar": {
    "show": false,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "git_status": true,
    "close_position": "right",
    "file_icons": true,
    "show_close_button": "hidden",
    "show_diagnostics": "all",
  },
  // Toolbar related settings
  "toolbar": {
    // Whether to show breadcrumbs.
    "breadcrumbs": true,
    // Whether to show quick action buttons.
    "quick_actions": false,
    // Whether to show the Selections menu in the editor toolbar.
    "selections_menu": false,
    // Whether to show agent review buttons in the editor toolbar.
    "agent_review": false,
  },
  "indent_guides": {
    // "active_line_width": 2,
    // "coloring": "indent_aware",
    // "background_coloring": "indent_aware"
  },
  "preview_tabs": {
    "enabled": false,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": true,
  },
  "terminal": {
    // "font_family": "BlexMonoNF"
    // "font_size": 20,
    // "font_weight": 400,
    // "line_height": "standard"
    // "shell": {
    //   "program": "bash"
    // }
    "dock": "bottom",
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "file_types": {
    "ini": ["desktop"],
    "Shell Script": [".envrc", "~/.config/environment.d/**/*"],
  },
  "languages": {
    "Nix": {
      "language_servers": ["!nixd", "!nil"],
    },
  },
  "profiles": {
    "Wide": {
      "settings": {
        // "diff_view_style": "split",
        "terminal": {
          "dock": "left",
          "default_width": 900,
        },
        "notification_panel": {
          "dock": "left",
          "default_width": 900,
        },
        "outline_panel": {
          "dock": "left",
          "default_width": 900,
        },
        "git_panel": {
          "dock": "left",
          "default_width": 900,
        },
        "project_panel": {
          "dock": "left",
          "default_width": 900,
        },
        "agent": {
          "dock": "left",
          "default_width": 900,
        },
      },
    },
  },
}
