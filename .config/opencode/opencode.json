{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-4.6",
  "lsp": false,
  "permission": {
    "external_directory": {
      "~/.cargo/git/**": "allow"
    },
    "read": {
      "~/.cargo/git/**": "allow"
    }
  },
  "disabled_providers": ["ollama"],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
  }
}
