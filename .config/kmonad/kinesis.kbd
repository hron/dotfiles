(defcfg
  ;; For Linux
  input  (device-file "/dev/input/by-id/usb-Kinesis_Advantage2_Keyboard_314159265359-if01-event-kbd")
  output (uinput-sink "Kmonad Kinesis"
    "/usr/bin/sleep 1 && /usr/bin/setxkbmap -option compose:menu")
  cmp-seq menu    ;; Set the compose key to `RightAlt'
  cmp-seq-delay 5 ;; 5ms delay between each compose-key sequence press

  ;; For Windows
  ;;input  (low-level-hook)
  ;;output (send-event-sink)

  ;; Comment this if you want unhandled events not to be emitted
  fallthrough true

  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd true
)

(defsrc
  esc  F1   F2   F3   F4   F5   F6   F7   F8   F9   F10  F11  F12  prnt slck pause

  =    1    2    3    4    5                   6    7    8    9    0    -
  tab  q    w    e    r    t                   y    u    i    o    p    \
  caps a    s    d    f    g                   h    j    k    l    ;    '
  lsft z    x    c    v    b                   n    m    ,    .    / rsft
       grv  rmet left rght                          up   down [    ]

                           lctl lalt   ralt rctl
                      bspc del  home   pgup  ret spc
                                 end   pgdn
)

;;
;; Aliases
;;

;; QWERTY layers bindings
(defalias
    +a (tap-next-release a lmet)
    +s (tap-next-release s lalt)
    +d (tap-next-release d lctl)
    +f (tap-next-release f lsft)
    +g (tap-next-release g (layer-toggle hyper))

    +h (tap-next-release h (layer-toggle hyper))
    +j (tap-next-release j rsft)
    +k (tap-next-release k rctl)
    +l (tap-next-release l lalt)
    +; (tap-next-release ; rmet)

)

;; Hyper layers aliases
(defalias
    wf4 A-F4
    lck (cmd-button "C:\\Windows\\System32\\rundll32.exe user32.dll,LockWorkStation")
    gam (layer-switch gaming)
    dlf (around rmet (around rctrl left))
    drt (around rmet (around rctrl rght))
    wlf (around rmet left)
    wrt (around rmet rght)
)

;; Gaming layer aliases
(defalias
    qwe (layer-switch qwerty)
)

;;
;; Layers
;;
(deflayer qwerty
  caps F1   F2   F3   F4   F5   F6   F7   F8   F9   F10  F11  F12  prnt slck pause

  =    1    2    3    4    5                   6    7    8    9    0    -
  tab  q    w    e    r    t                   y    u    i    o    p    \
  esc  @+a  @+s  @+d  @+f  @+g                 @+h  @+j  @+k  @+l  @+;  '
  XX   z    x    c    v    b                   n    m    ,    .    /    XX
       grv  XX   left rght                          up   down [    ]

                           XX   XX     XX   XX
                      bspc del  home   pgup  ret spc
                                 end   pgdn
)

(deflayer hyper
  _    _    _    _    _    _    _    _    _    _     _    _    _     _    _     _

  F12  F1   F2   F3   F4   F5                  F6   F7   F8   F9   F10  F11
  _    _    _    _    _    _                   menu @wlf @wrt _    _    _
  _    _    _    _    _    _                   _    _    _    _    M-1  M-2
  _    _    _    _    _    _                   @wf4 _    _    M-3  _    @gam
       _    _    _    _                             @dlf @drt M-4  M-5

                           _    _      mute next
                      _    _    _      volu pp  _
                                _      vold
)


(deflayer gaming
  _    _    _    _    _    _    _    _    _    _     _    _    _     _    @qwe _

  _    _    _    _    _    _                   _    _    _    _    _    _
  _    _    _    _    _    _                   _    _    _    _    _    _
  _    _    _    _    _    _                   _    _    _    _    _    _
  _    _    _    _    _    _                   _    _    _    _    _    _
       _    _    _    _                             _    _    _    _

                           _    _      _    _
                      spc  _    _      _    _   bspc
                                _      _
)
