(defcfg
  ;; For Linux
  input  (device-file "/dev/input/by-id/usb-Kinesis_Advantage2_Keyboard_314159265359-if01-event-kbd")
  output (uinput-sink "Kmonad Kinesis"
    "/usr/bin/sleep 1 && /usr/bin/setxkbmap -option compose:menu")
  cmp-seq menu    ;; Set the compose key to `RightAlt'
  cmp-seq-delay 5 ;; 5ms delay between each compose-key sequence press

  ;; For Windows
  ;;input  (low-level-hook)
  ;;output (send-event-sink)

  ;; Comment this if you want unhandled events not to be emitted
  fallthrough true

  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd true
)

(defsrc
  esc  F1   F2   F3   F4   F5   F6   F7   F8   F9   F10  F11  F12  prnt slck pause

  =    1    2    3    4    5                   6    7    8    9    0    -
  tab  q    w    e    r    t                   y    u    i    o    p    \
  caps a    s    d    f    g                   h    j    k    l    ;    '
  lsft z    x    c    v    b                   n    m    ,    .    / rsft
       grv  rmet left rght                          up   down [    ]

                           lctl lalt   ralt rctl
                      bspc del  home   pgup  ret spc
                                 end   pgdn
)

;;
;; Aliases
;;
(defalias
    wf4 A-F4
    lck (cmd-button "C:\\Windows\\System32\\rundll32.exe user32.dll,LockWorkStation")
    wsp M-spc

    +a (tap-hold-next-release 200 a lmet)
    +s (tap-hold-next-release 200 s lalt)
    +d (tap-hold-next-release 200 d lctl)
    +f (tap-hold-next-release 200 f lsft)
    +g (tap-hold-next-release 200 g (layer-toggle hyper))

    +h (tap-hold-next-release 200 h (layer-toggle hyper))
    +j (tap-hold-next-release 200 j rsft)
    +k (tap-hold-next-release 200 k rctl)
    +l (tap-hold-next-release 200 l lalt)
    +; (tap-hold-next-release 200 ; rmet)
)



;;
;; Layers
;;
(deflayer qwerty
  caps F1   F2   F3   F4   F5   F6   F7   F8   F9   F10  F11  F12  prnt slck pause

  =    1    2    3    4    5                   6    7    8    9    0    -
  tab  q    w    e    r    t                   y    u    i    o    p    \
  esc  @+a  @+s  @+d  @+f  @+g                 @+hl  @+j  @+k  @+l  @+;  '
  lsft z    x    c    v    b                   n    m    ,    .    / rsft
       grv  rmet left rght                          up   down [    ]

                           lctl lalt   ralt rctl
                      bspc del  home   pgup  ret spc
                                 end   pgdn
)

(deflayer hyper
  _    _    _    _    _    _    _    _    _    _     _    _    _     _    _     _

  _    _    _    _    _    _                   _    _    _    _    _    _
  _    _    _    _    _    _                   _    _    _    _    _    _
  _    _    _    _    _    _                   _    _    _    @lck _    _
  _    _    _    _    _    _                   @wf4 _    _    _    _    _
       _    _    _    _                             _    _    _    _

                           _    _      _    _
                      _    _    _      _    _   @wsp
                                _      _
)


(deflayer numbers
  _    _    _    _    _    _    _    _    _    _     _    _    _     _    _     _

  _    _    _    _    _    _                   _    _    _    _    _    _
  _    _    _    _    _    _                   _    7    8    9    _    _
  _    _    _    _    _    _                   _    4    5    6    _    _
  _    _    _    _    _    _                   _    1    2    3    _    _
       _    _    _    _                             _    _    _    _

                           _    _      _    _
                      _    _    _      _    _   _
                                _      _
)
