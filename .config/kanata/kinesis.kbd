(defcfg
  linux-dev /dev/input/by-id/usb-Kinesis_Advantage2_Keyboard_314159265359-if01-event-kbd
  process-unmapped-keys yes
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prnt slck pause

  =    1    2    3    4    5                   6    7    8    9    0    -
  tab  q    w    e    r    t                   y    u    i    o    p    \
  caps a    s    d    f    g                   h    j    k    l    ;    '
  lsft z    x    c    v    b                   n    m    ,    .    / rsft
       grv  rmet left rght                          up   down [    ]

                           lctl lalt   ralt rctl
                      bspc del  home   pgup  ret spc
                                 end   pgdn
)

(include common.kbd)

;;
;; Layers
;;
(deflayer base
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX

  XX   XX   XX   XX   XX   XX                  XX   XX   XX   XX   XX   XX
  XX   q    w    e    r    t                   y    u    i    o    p    XX
  XX   @+a  @+s  @+d  @+f  g                   h    @+j  @+k  @+l  @+'  XX
  XX   @+z  @+x  c    v    b                   n    m    ,    @+.  @+/  XX
       XX   XX   XX   XX                            XX   XX   XX   XX

                           XX   XX     XX    XX
                      @esc @spc XX     XX    @bsp @del
                                @tab   @ent
)

(deflayer extra
  caps _   _   _   _   _   _   _   _   _  _   _   _   _   @bas _

  _   _   _   _   _   _                   _   _   _   _   _    _
  _   _   _   _   _   _                   _   _   _   _   _    _
  esc _   _   _   _   _                   _   _   _   _   _    _
  _   _   _   _   _   _                   _   _   _   _   _    _
      _   _   _   _                           _   _   _   _

                            _   _      _   _
                      spc  ent  _      _   bspc del
                                _      _
)

(deflayer tap
  _   _   _   _   _   _   _   _   _   _    _   _   _   _  @bas _

  _   _   _   _   _   _                   _   _   _   _   _    _
  _   _   _   _   _   _                   _   _   _   _   _    _
  _   _   _   _   _   _                   _   _   _   _   _    _
  _   _   _   _   _   _                   _   _   _   _   _    _
      _   _   _   _                           _   _   _   _

                          _   _      _   _
                      _   _   _      _   _   _
                              _      _
)

(deflayer button
