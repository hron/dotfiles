(deflayer media
  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX     XX    XX    XX    XX    XX    XX

  XX    XX    XX    XX    XX    XX                    XX    XX    XX    XX    XX    XX
  XX    XX    @Dtap @Dext @Dbse XX                    XX    XX    XX    XX    XX    XX
  XX    met   alt   ctl   sft   XX                    XX    prev  vold  volu  next  XX
  XX    XX    ralt  @Dfun @Dmed XX                    XX    XX    XX    XX    XX    XX
        XX    XX    XX    XX                                XX    XX    XX    XX

                            XX    XX       XX    XX
                       XX   XX    XX       XX    pp    mute
                                  XX       pp
)

(deflayer num
  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX     XX    XX    XX    XX    XX    XX

  XX    XX    XX    XX    XX    XX                    XX    XX    XX    XX    XX    XX
  XX    [     7     8     9     ]                     XX    @Dbse @Dext @Dtap XX    XX
  XX    ;     4     5     6     =                     XX    sft   ctl   alt   met   XX
  XX    `     1     2     3     \                     XX    @Dnum @Dnav ralt  XX    XX
        XX    XX    XX    XX                                XX    XX    XX    XX

                            XX    XX       XX    XX
                       .    0     XX       XX    XX    XX
                                  -        XX
)

(deflayer sym
  XX    XX    XX    XX    XX    XX    XX    XX    XX    XX     XX    XX    XX    XX    XX    XX

  XX    XX    XX    XX    XX    XX                    XX    XX    XX    XX    XX    XX
  XX    {     @&    @*    @ocb  }                     XX    @Dbse @Dext @Dtap XX    XX
  XX    @:    @$    @%    @^    +                     XX    sft   ctl   alt   met   XX
  XX    @~    @!    @@    @#    @|                    XX    @Dsym @Dmos ralt  XX    XX
        XX    XX    XX    XX                                XX    XX    XX    XX

                            XX    XX       XX    XX
                       @ocb @ccb  XX       XX    XX   XX
                                  @_       XX
