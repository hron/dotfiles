Emacs*font: -xos4-terminus-medium-*-*-*-14-*-*-*-*-*-iso10646-1
! Emacs*font: Dejavu Sans Mono 13
! Emacs*useXIM: true
! Emacs*font: Ubuntu Mono 10
! Emacs.FontBackend: xft
! Emacs*font: Ubuntu Mono 15

Xcursor.size: 18
Xcursor.theme: Human
Xcursor.theme_core: true

*VT100*foreground: white
*VT100*background: black
*VT100.eightBitInput: false
*VT100.font: -*-terminus-medium-r-*-*-14-*-*-*-*-*-iso10646-*

! use xft for drawing fonts
urxvt.font: -*-terminus-medium-r-*-*-14-*-*-*-*-*-iso10646-*
urxvt.background: black
urxvt.foreground: white
! make a scrollbar thats nearly black
urxvt*scrollBar:     true
urxvt*scrollBar_floating:    true
urxvt*scrollBar_right:   false
urxvt*scrollColor:       #202020
urxvt*termName:     xterm
urxvt*urllauncher:           firefox
! matcher.button # 3 is a right-click
urxvt*matcher.button:        3
urxvt*saveLines:              8192
urxvt.perl-ext-common:         default,matcher,tabbed
! black
urxvt*color0:      #222222
urxvt*color8:      #666666
! red
urxvt*color1:      #9e1828
urxvt*color9:      #cf6171
! green
urxvt*color2:      #aece92
urxvt*color10:     #c5f779
! yellow
urxvt*color3:      #968a38
urxvt*color11:     #fff796
! blue
urxvt*color4:      #71C5F4
urxvt*color12:     #67CDE9
! magenta
urxvt*color5:      #963c59
urxvt*color13:     #cf9ebe
! cyan
urxvt*color6:      #418179
urxvt*color14:     #71bebe
! white
urxvt*color7:      #bebebe
urxvt*color15:      #FFFFFF

urxvt*cursorColor:       #d8d8d8

! Local variables:
! compile-command: "xrdb ~/.Xresources"
! End:
